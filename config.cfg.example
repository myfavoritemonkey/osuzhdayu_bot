[telegram]
# Токен от @BotFather
bot_token = PASTE_TELEGRAM_BOT_TOKEN_HERE
# Включите true, чтобы бот обрабатывал пересланные из группы сообщения в ЛС
relay_forwarded_messages = false
# ID общего чата, например -1001234567890 (узнаётся командой /id в группе)
relay_chat_id =

[deepseek]
# Ключ с https://platform.deepseek.com/
api_key = PASTE_DEEPSEEK_API_KEY_HERE
base_url = https://api.deepseek.com
model = deepseek-flash
temperature = 1.0
max_tokens = 120
request_timeout = 30

[bot]
# Несколько триггеров можно перечислить через запятую
trigger_words = осуждаю
# true: дополнительно анализировать обращения к боту (reply, @упоминание или слово «бот»)
# false: отвечать только на сообщения с trigger_words
respond_to_direct_messages = false
# Формы слова «бот», запускающие анализ обращения (через запятую)
bot_reference_words = бот, бота, боту, боте, ботом, боты, ботов, ботам, ботами, ботах, ботик, ботика, ботику, ботики
# Сколько следующих сообщений после ответа бота проверять по контексту
context_messages_after_reply = 3
# Через сколько секунд полностью сбрасывать контекст и системные настройки
context_reset_seconds = 60
cooldown_seconds = 8
max_message_chars = 4000
# Необязательная замена системной инструкции для DeepSeek
system_prompt = Ты остроумный, доброжелательный собеседник в русскоязычном Telegram-чате. На сообщение с осуждением придумай короткую (1–2 предложения) смешную парировку. Не оскорбляй внешность, происхождение, здоровье или другие защищаемые признаки. Не угрожай и не используй ненормативную лексику. Ответь только готовой репликой, без пояснений.
